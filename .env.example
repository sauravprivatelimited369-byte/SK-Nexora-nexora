# Local development uses an embedded, persistent PostgreSQL database (PGlite) in .nexora-data/.
# Set DATABASE_URL to a managed PostgreSQL URL (Supabase, Neon, etc.) for production.
DATABASE_URL=

# OpenAI-compatible chat completions endpoint (server-side only). Leave blank to use the transparent starter-planner mode.
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

# Email verification is required when SMTP_HOST is set. Configure a real transactional mail provider for public production signups.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=NEXORA <no-reply@example.com>

# Razorpay recurring plan IDs. Create monthly plans in Razorpay and set the corresponding plan ids here.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_PRO_PLAN_ID=
RAZORPAY_CAREER_PLAN_ID=

# Canonical origin for emails and payment callbacks, e.g. https://nexora.app
APP_URL=http://localhost:3000

# Optional product analytics (server-side only)
ANALYTICS_KEY=
